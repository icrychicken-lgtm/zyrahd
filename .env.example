# Kopiere diese Datei zu ".env" und trage deine eigenen Werte ein.
# Alles, was Rollen-/Kanal-IDs betrifft, wird NICHT hier konfiguriert, sondern
# später bequem im Dashboard unter "Einstellungen".

# --- Discord Bot ---
DISCORD_BOT_TOKEN=
GUILD_ID=
INITIAL_ADMIN_DISCORD_IDS=

# --- Discord OAuth2 ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# --- Flask ---
FLASK_SECRET_KEY=
FLASK_HOST=0.0.0.0
FLASK_PORT=5042

# --- Interne API ---
INTERNAL_API_HOST=127.0.0.1
INTERNAL_API_PORT=5050
INTERNAL_API_SECRET=

# --- Sonstiges ---
TIMEZONE=Europe/Berlin

# Optional:
# DATABASE_URL=sqlite:////pfad/zu/bot.db
